# Environment configuration for verdery-dev.
#
# Source: ADR-0007 (region), ADR-0011 (scripts instead of Terraform).
# Read by every script in infrastructure/gcloud/scripts/ — nothing here is
# hardcoded into a script, so a future staging.env or prod.env stands up an
# equivalent environment without editing script logic.

VERDERY_ENVIRONMENT="development"
VERDERY_PROJECT_ID="verdery-dev"
VERDERY_PROJECT_NAME="Verdery Dev"
VERDERY_BILLING_ACCOUNT_ID="011376-3DA0B7-CA8AC5"
VERDERY_REGION="us-central1"

VERDERY_NETWORK_NAME="verdery-dev-network"
VERDERY_SUBNET_NAME="verdery-dev-subnet"
VERDERY_SUBNET_RANGE="10.60.0.0/20"
VERDERY_PEERING_RANGE_NAME="verdery-dev-google-managed-services"
VERDERY_PEERING_PREFIX_LENGTH="16"

VERDERY_SQL_INSTANCE_NAME="verdery-dev-pg"
VERDERY_SQL_DATABASE_VERSION="POSTGRES_17"
VERDERY_SQL_TIER="db-f1-micro"
VERDERY_SQL_DATABASE_NAME="verdery"

VERDERY_ARTIFACT_REPOSITORY="verdery"

VERDERY_USER_MEDIA_BUCKET="verdery-dev-user-media"
VERDERY_RAW_CAPTURE_BUCKET="verdery-dev-raw-capture"
VERDERY_DERIVED_BUCKET="verdery-dev-derived"
VERDERY_EXPORTS_BUCKET="verdery-dev-exports"

VERDERY_DEPLOY_SERVICE_ACCOUNT_ID="verdery-dev-deployer"
VERDERY_RUNTIME_SERVICE_ACCOUNT_ID="verdery-dev-api-runtime"
# P6-ASYNC-01: the relay/worker deployment's own least-privilege identity,
# distinct from the API's runtime service account per architecture/media-
# storage-and-processing.md section 18 ("Separate read/write permissions by
# worker role") — see infrastructure/gcloud/scripts/10-media-processing-queue.sh
# (drafted, not yet run against verdery-dev).
VERDERY_WORKER_SERVICE_ACCOUNT_ID="verdery-dev-worker"

VERDERY_WORKLOAD_IDENTITY_POOL_ID="github-actions"
VERDERY_WORKLOAD_IDENTITY_PROVIDER_ID="github-actions-oidc"
VERDERY_GITHUB_REPOSITORY="t-boris/verdery"
VERDERY_GITHUB_ENVIRONMENT="development"

VERDERY_CLOUD_RUN_SERVICE_NAME="verdery-api-dev"
# P6-ASYNC-01: the always-on relay/worker Cloud Run service (min-instances=1 —
# see 10-media-processing-queue.sh's own comment for why this is a Service,
# not a Job) and its Cloud Tasks queue.
VERDERY_WORKERS_CLOUD_RUN_SERVICE_NAME="verdery-workers-dev"
VERDERY_MEDIA_PROCESSING_QUEUE_NAME="media-processing-dev"

# Cloud SQL access for services/api uses IAM database authentication, not a
# stored connection string — see infrastructure/gcloud/scripts/07-iam-
# database-bootstrap.sh — so there is deliberately no DATABASE_URL secret
# name for the API here.
#
# services/workers is different: its own configuration.ts deliberately uses a
# plain DATABASE_URL connection string, not Cloud SQL IAM mode (see that
# file's own header comment on why that second Google Cloud dependency,
# @google-cloud/cloud-sql-connector, was not added in the same stage that
# already justified @google-cloud/tasks). This name is the Secret Manager
# secret deploy-workers.sh references via --set-secrets; the secret ITSELF
# (a `gcloud secrets create` plus a version holding a real, working
# connection string, and roles/secretmanager.secretAccessor granted to
# VERDERY_WORKER_SERVICE_ACCOUNT_ID) has not been created against
# verdery-dev yet — see deploy-workers.sh's own header comment.
VERDERY_WORKER_DATABASE_URL_SECRET_NAME="verdery-dev-worker-database-url"

VERDERY_TRACING_ENABLED="true"

# Web client Cloud Run service (Phase 8 web deployment stage). The web app is
# a stateless Next.js standalone server; NEXT_PUBLIC_* values are baked at
# image build time from the committed, non-secret .env.example values plus
# this API origin.
VERDERY_WEB_SERVICE_NAME="verdery-web-dev"
VERDERY_WEB_RUNTIME_SERVICE_ACCOUNT_ID="verdery-dev-web-runtime"
VERDERY_FIREBASE_WEB_APP_ID="1:417008876420:web:f41b91b1e56ec5ab217bd1"

# Custom web hostname, served by a Cloud Run DOMAIN MAPPING (`gcloud beta run
# domain-mappings create --service=verdery-web-dev --domain=dev.verdery-app.com`),
# not by 11-load-balancer.sh. The load balancer that script creates is a
# SECURITY chokepoint for Cloud Armor (T-COST-01/02, T-SSRF-06) and costs
# ~18 USD/month; a custom hostname needs none of it. Only the WEB host is
# mapped: the browser never talks to the API directly, because the web server
# proxies /v1/* (apps/web/next.config.ts), which is also what keeps the
# host-only `SameSite=strict` session cookie first-party. So there is
# deliberately no VERDERY_API_DOMAIN here — the API keeps its own run.app URL,
# and 11-load-balancer.sh (which requires BOTH) stays unapplied.
#
# Setting this changes two deployed values, both handled automatically:
# deploy-api.sh sets HTTP_ALLOWED_ORIGINS to exactly this origin, and
# deploy-web.sh synchronizes the same value onto the API service. Because that
# REPLACES the generated run.app origins rather than adding to them, this line
# was added only after https://dev.verdery-app.com already served a real page.
# Firebase Auth / reCAPTCHA / App Check need the host too — run
# `sync-web-auth-domains.sh dev`, which merges it in without dropping the
# existing run.app aliases.
VERDERY_WEB_DOMAIN="dev.verdery-app.com"

# ADR-0015: real plant-photo identification and condition tracking via
# Vertex AI. Enabled here, in development ONLY, for the owner's own manual
# spot-check against real garden-plant photos — implementation-plan.md
# section 19.2 requires the owner's confirmation of Vertex AI's current
# data-training/retention terms for image content before enabling EITHER
# capability outside development; development itself is explicitly not
# gated by that requirement, since this dev-only spot-check is how that
# evidence gets produced. Do not copy these two ENABLED flags as "true" into
# a future staging.env/prod.env without that confirmation first.
#
# VERDERY_PLANT_SPECIES_AI_MODEL/VERDERY_PLANT_CONDITION_AI_MODEL name an
# explicit, evaluated Gemini model choice (configuration-schema.ts's own
# "never defaulted by code" reasoning for RECOMMENDATION_AI_MODEL).
# gemini-3.6-flash is confirmed directly against this project's own Vertex
# AI endpoint to answer real `generateContent` calls — but only under
# location `global` (see VERDERY_AI_VERTEX_LOCATION below), never under a
# regional location, where it 404s.
VERDERY_PLANT_SPECIES_AI_ENABLED="true"
VERDERY_PLANT_SPECIES_AI_MODEL="gemini-3.6-flash"
VERDERY_PLANT_CONDITION_AI_ENABLED="true"
VERDERY_PLANT_CONDITION_AI_MODEL="gemini-3.6-flash"

# ADR-0018: reading an uploaded plat of survey into a boundary and the
# objects the sheet draws. Enabled here for the same reason as the two
# capabilities above — development only, for the owner's own use — and named
# explicitly rather than defaulted in code. Verified against this project's
# own Vertex endpoint on a real plat: the transcription's traverse closes to
# 0.42 m and its area agrees with the sheet's stated 10,068 sq ft to 0.27%.
VERDERY_PLAT_READING_ENABLED="true"
VERDERY_PLAT_READING_MODEL="gemini-3.6-flash"
# Deliberately NOT ${VERDERY_REGION} (us-central1) — confirmed directly that
# gemini-3.5-flash/gemini-3.6-flash answer only from Vertex AI's `global`
# location; deploy-api.sh falls back to ${VERDERY_REGION} when this is
# unset, so only an environment that actually uses one of these models needs
# to set it.
VERDERY_AI_VERTEX_LOCATION="global"

# --- Monitoring (P11-OBS-01) --------------------------------------------
# The one notification channel every alert policy in this project shares —
# infra-level (15-monitoring-alerts.sh, not yet run against this project)
# and application-level (17-plant-intelligence-monitoring.sh) alike, the
# same "one operator, one destination" posture prod.env's own comment
# documents for its own (still-empty) VERDERY_ALERT_EMAIL.
VERDERY_ALERT_EMAIL="t.boris@gmail.com"
VERDERY_ALERT_CHANNEL_DISPLAY_NAME="Verdery Dev alerts"
# 15-monitoring-alerts.sh's own two thresholds — required by that script but
# never previously set for this environment (its own policies have never
# been created against verdery-dev; see that script's header comment).
# db-f1-micro's own connection ceiling is far lower than production's, so
# these are dev-appropriate starting points, not the production formula
# prod.env's own comments derive.
VERDERY_SQL_CONNECTION_ALERT_THRESHOLD="80"
VERDERY_INSTANCE_COUNT_ALERT_THRESHOLD="8"
# 17-plant-intelligence-monitoring.sh's own two thresholds (P11-OBS-01) —
# fixed starting points, not a baseline comparison: this signal has no
# production traffic history yet. See each alert policy's own documentation
# field for the reasoning; revisit both once real usage exists.
VERDERY_ZERO_RESULT_SEARCH_THRESHOLD="20"
VERDERY_ENRICHMENT_DURATION_THRESHOLD_MS="300000"
