# Environment configuration for the production project.
#
# Source: ADR-0007 (us-central1 primary region, separate production project,
# regional-HA private Cloud SQL, global HTTPS load balancer with Cloud Armor);
# ADR-0011 (scripts instead of Terraform); architecture/environments-and-
# delivery.md section 5, whose directory tree reserves exactly this file.
#
# ----------------------------------------------------------------------------
# NOTHING IN THIS FILE HAS BEEN APPLIED.
#
# The production project does not exist. Every line below is a reviewed value
# waiting for an owner to run the sequence in ../README.md, and every value the
# owner alone can supply is left EMPTY and marked `OWNER DECISION`. Empty is
# deliberate: `require_config` in scripts/lib/common.sh fails fast naming the
# variable, so no script can provision a certificate for a made-up domain or a
# budget for a made-up amount. A plausible-looking placeholder would be applied
# for real by a script that cannot tell the difference.
# ----------------------------------------------------------------------------

VERDERY_ENVIRONMENT="production"
VERDERY_PROJECT_ID="verdery-prod"
VERDERY_PROJECT_NAME="Verdery Production"
# OWNER DECISION (billing): the development account id, repeated here because a
# single account is the simplest correct starting point and 16-budget.sh scopes
# the budget to this project rather than to the account. Replace it if
# production should bill separately.
VERDERY_BILLING_ACCOUNT_ID="011376-3DA0B7-CA8AC5"
# ADR-0007: "Use us-central1 as the primary region for the API, Cloud SQL,
# jobs, queues where regional selection applies, and primary media processing."
VERDERY_REGION="us-central1"

# --- Network ----------------------------------------------------------------
# networking.md section 9 requires "a dedicated regional application subnet
# sized for Cloud Run instance and job IP behavior with growth margin" and
# non-overlap validation. 10.70.0.0/20 is 4,094 usable addresses and does not
# overlap the development subnet (10.60.0.0/20), so a future peering or a
# recovery project standing both up at once cannot collide.
#
# Capacity check against the instance plan below (Direct VPC egress consumes
# roughly one subnet address per running Cloud Run instance, more during a
# revision overlap): peak planned instances are 8 API + 2 workers + 1 job = 11,
# and even at 4x deploy overlap that is 44 of 4,094. The subnet is not the
# binding constraint; the database connection ceiling is (see the connection
# budget under "Cloud SQL"), which is why the capacity alert is keyed on Cloud
# Run instance count rather than on subnet addresses.
VERDERY_NETWORK_NAME="verdery-prod-network"
VERDERY_SUBNET_NAME="verdery-prod-subnet"
VERDERY_SUBNET_RANGE="10.70.0.0/20"
VERDERY_PEERING_RANGE_NAME="verdery-prod-google-managed-services"
VERDERY_PEERING_PREFIX_LENGTH="16"

# --- Cloud SQL --------------------------------------------------------------
# reliability-and-disaster-recovery.md section 6 requires regional high
# availability, automated backups, PITR, storage auto-growth WITH a cost cap,
# restricted maintenance scheduling, and deletion protection. 14-cloud-sql-
# hardening.sh applies every value below; each one's reasoning and its downtime
# cost live in that script's header.
VERDERY_SQL_INSTANCE_NAME="verdery-prod-pg"
VERDERY_SQL_DATABASE_VERSION="POSTGRES_17"
# NOT db-f1-micro. Cloud SQL does not offer high availability on shared-core
# machine types, so the development tier cannot satisfy section 6 at all —
# regional HA and the tier change are one decision, not two.
# db-custom-1-3840 (1 vCPU, 3.75 GB) is the smallest dedicated-core tier and
# therefore the cheapest configuration that can be regional.
VERDERY_SQL_TIER="db-custom-1-3840"
VERDERY_SQL_DATABASE_NAME="verdery"
VERDERY_SQL_AVAILABILITY_TYPE="REGIONAL"
VERDERY_SQL_STORAGE_SIZE_GB="20"
# reliability-and-disaster-recovery.md section 6: "Storage auto-growth with
# alerting and maximum-cost review." Growth without a ceiling is an unbounded
# bill; 100 GB is five times the initial allocation and is the number the
# capacity alert is sized against.
VERDERY_SQL_STORAGE_AUTO_RESIZE_LIMIT_GB="100"
VERDERY_SQL_BACKUP_START_TIME="08:00"
VERDERY_SQL_RETAINED_BACKUPS="30"
# PITR transaction-log retention. Section 3's RPO is "no more than five
# minutes", which PITR satisfies at any retention; 7 days is the window in
# which a destructive change can still be recovered from after a weekend.
VERDERY_SQL_RETAINED_TRANSACTION_LOG_DAYS="7"
# Sunday 10:00 UTC is 04:00 US Central — the lowest-traffic hour for a US-first
# consumer gardening product, and after the 08:00 UTC backup has completed.
VERDERY_SQL_MAINTENANCE_WINDOW_DAY="SUN"
VERDERY_SQL_MAINTENANCE_WINDOW_HOUR="10"
# `production` receives updates weeks after the `preview` channel, which is the
# correct side of that trade for the only environment holding real user data.
VERDERY_SQL_MAINTENANCE_RELEASE_CHANNEL="production"
#
# The connection budget. `max_connections` is a static PostgreSQL parameter, so
# this value is only changeable with a restart; it is set explicitly rather
# than inherited so that the number the pools are sized against is written down
# somewhere a person can read.
#
#   API           8 instances x 5 pooled connections            40
#   workers       2 instances x 5 pooled connections            10
#   migration job 1 execution x 2 pooled connections             2
#   Cloud SQL system agents + superuser_reserved_connections     8
#   ------------------------------------------------------------
#   allocated                                                   60
#   unallocated headroom (operator sessions, break-glass,        40
#   revision overlap during a deploy)
#   ------------------------------------------------------------
#   max_connections                                            100
#
# 100 also suits the tier: each PostgreSQL backend costs several megabytes of
# private memory before any work_mem, and 3.75 GB does not support the 200-400
# range a larger instance would.
VERDERY_SQL_MAX_CONNECTIONS="100"

# --- Cloud Run capacity -----------------------------------------------------
# networking.md section 11 names exactly these three numbers ("Maximum Cloud
# Run instances", "Maximum pool size per instance", "Request concurrency per
# instance") as the levers that keep Cloud Run scaling inside database
# capacity. They are configuration here rather than literals in deploy-api.sh
# so that the connection budget above and the deployed service cannot drift.
#
# Concurrency 40 against a pool of 5 is an 8:1 ratio, which is right for this
# API: most request time is Firebase token verification, Cloud Storage URL
# signing, and serialization, not a held database connection. A saturated pool
# degrades through the 15 s acquisition timeout and the 10 s statement timeout
# into 503s, rather than exhausting PostgreSQL.
VERDERY_API_MAX_INSTANCES="8"
VERDERY_API_CONCURRENCY="40"
VERDERY_DATABASE_POOL_MAX_CONNECTIONS="5"
VERDERY_WEB_MAX_INSTANCES="8"

# --- Edge: domains, load balancer, Cloud Armor -------------------------------
# OWNER DECISION (domain): no domain is registered. networking.md section 14
# specifies `app.<product-domain>` and `api.<product-domain>`; fill both in
# together. 11-load-balancer.sh requests one Google-managed certificate
# covering both names and will not run until they are set.
#
# The load balancer routes BOTH hosts:
#   api.<domain>/*      -> API backend            (native iOS client)
#   app.<domain>/v1/*   -> API backend            (browser, first-party)
#   app.<domain>/*      -> web backend
#
# `app.<domain>/v1/*` is the load-bearing rule. The session cookie is
# `SameSite=strict` and host-only (services/api/.../session-routes.ts), which
# is why the deployed web client proxies `/v1/*` through its own Next.js server
# today. Path-routing `/v1/*` at the load balancer replaces that proxy: the
# browser stays first-party, and Cloud Armor sees the real client IP on API
# requests instead of the web service's single egress address — without which
# every per-IP rate limit below would share one bucket for all browser traffic
# and be worthless.
VERDERY_WEB_DOMAIN=""
VERDERY_API_DOMAIN=""

VERDERY_LB_ADDRESS_NAME="verdery-prod-lb-ip"
VERDERY_LB_API_NEG_NAME="verdery-prod-api-neg"
VERDERY_LB_WEB_NEG_NAME="verdery-prod-web-neg"
VERDERY_LB_API_BACKEND_NAME="verdery-prod-api-backend"
VERDERY_LB_WEB_BACKEND_NAME="verdery-prod-web-backend"
VERDERY_LB_CERTIFICATE_NAME="verdery-prod-cert"
VERDERY_LB_URL_MAP_NAME="verdery-prod-url-map"
VERDERY_LB_REDIRECT_URL_MAP_NAME="verdery-prod-http-redirect"
VERDERY_LB_HTTPS_PROXY_NAME="verdery-prod-https-proxy"
VERDERY_LB_HTTP_PROXY_NAME="verdery-prod-http-proxy"
VERDERY_LB_HTTPS_FORWARDING_RULE_NAME="verdery-prod-https-rule"
VERDERY_LB_HTTP_FORWARDING_RULE_NAME="verdery-prod-http-rule"
VERDERY_ARMOR_POLICY_NAME="verdery-prod-edge"

# Cloud Run ingress. `internal-and-cloud-load-balancing` is the setting that
# actually removes public reachability of the generated `*.run.app` URLs, and
# with it the threat model's `T-COST-01` (unauthenticated flood straight past
# the edge) and half of `T-SSRF-06` (`/v1/internal/*` reachable on the service
# URL). The `allUsers` invoker binding stays: for a serverless NEG the load
# balancer forwards requests unauthenticated, so removing it would break the
# only remaining path. Reachability, not IAM, is the control here.
#
# Development leaves this variable unset and keeps `all` — dev.env has no
# load balancer to be reachable through.
VERDERY_CLOUD_RUN_INGRESS="internal-and-cloud-load-balancing"

# --- Everything the existing numbered scripts already read -------------------
VERDERY_ARTIFACT_REPOSITORY="verdery"

VERDERY_USER_MEDIA_BUCKET="verdery-prod-user-media"
VERDERY_RAW_CAPTURE_BUCKET="verdery-prod-raw-capture"
VERDERY_DERIVED_BUCKET="verdery-prod-derived"
VERDERY_EXPORTS_BUCKET="verdery-prod-exports"

VERDERY_DEPLOY_SERVICE_ACCOUNT_ID="verdery-prod-deployer"
VERDERY_RUNTIME_SERVICE_ACCOUNT_ID="verdery-prod-api-runtime"
VERDERY_WORKER_SERVICE_ACCOUNT_ID="verdery-prod-worker"
VERDERY_WEB_RUNTIME_SERVICE_ACCOUNT_ID="verdery-prod-web-runtime"

VERDERY_WORKLOAD_IDENTITY_POOL_ID="github-actions"
VERDERY_WORKLOAD_IDENTITY_PROVIDER_ID="github-actions-oidc"
VERDERY_GITHUB_REPOSITORY="t-boris/verdery"
# environments-and-delivery.md section 6: "Production identity receives only
# required deploy permissions and is protected by GitHub environment approval
# and branch policy." This name must match a GitHub environment that has a
# required reviewer configured, or that approval gate does not exist.
VERDERY_GITHUB_ENVIRONMENT="production"

VERDERY_CLOUD_RUN_SERVICE_NAME="verdery-api"
VERDERY_WORKERS_CLOUD_RUN_SERVICE_NAME="verdery-workers"
VERDERY_MEDIA_PROCESSING_QUEUE_NAME="media-processing"
VERDERY_WEB_SERVICE_NAME="verdery-web"
# OWNER DECISION (Firebase): create the production web app, then copy its
# application ID here. The value is public configuration, not a secret.
VERDERY_FIREBASE_WEB_APP_ID=""

VERDERY_WORKER_DATABASE_URL_SECRET_NAME="verdery-prod-worker-database-url"

VERDERY_TRACING_ENABLED="true"

# --- Monitoring and budget ---------------------------------------------------
# OWNER DECISION (alert destination): the address that receives every alert
# 15-monitoring-alerts.sh creates. There is no default worth guessing; a policy
# with no notification channel is a dashboard, not an alert.
VERDERY_ALERT_EMAIL=""
VERDERY_ALERT_CHANNEL_DISPLAY_NAME="Verdery production on-call"

# Cloud Run instance-count alarm. 18 is derived, not chosen: (100 max
# connections - 8 reserved for Cloud SQL's own agents) / 5 pooled connections
# per instance = 18.4. At 18 simultaneous instances the connection budget is
# exactly spent if every pool fills, so this is the last moment the alert is
# still ahead of the failure. It also fires long before the subnet's 4,094
# addresses matter, which is why there is no separate subnet-address alarm —
# see the Network section above.
VERDERY_INSTANCE_COUNT_ALERT_THRESHOLD="18"
# 80% of VERDERY_SQL_MAX_CONNECTIONS.
VERDERY_SQL_CONNECTION_ALERT_THRESHOLD="80"

# OWNER DECISION (budget): the monthly amount, in whole USD, that 16-budget.sh
# creates a budget for. The runbooks name enabling one budget as "the cheapest
# risk reduction available"; the amount itself is a business decision. A
# defensible starting figure is the steady-state estimate in ../README.md
# rounded up — roughly 150 USD/month for the load balancer, Cloud Armor,
# regional Cloud SQL, and light traffic — but nothing here should choose it.
VERDERY_BUDGET_AMOUNT_USD=""
VERDERY_BUDGET_DISPLAY_NAME="Verdery production monthly"
